# SakuraBans editor site. Every setting is optional; the values below are the defaults.

# Where the server listens.
PORT=3000
# HOST=0.0.0.0

# Blob storage: "fs" (a directory) or "redis".
NUXT_EDITOR_STORAGE_DRIVER=fs
# The directory for "fs" (the Docker image uses /data).
NUXT_EDITOR_STORAGE_DIR=./.data/editor
# For "redis": redis://user:password@host:6379/0
NUXT_EDITOR_REDIS_URL=

# Lifetimes in seconds: snapshots (payloads), change sets and their results.
NUXT_EDITOR_PAYLOAD_TTL=86400
NUXT_EDITOR_CHANGES_TTL=3600
# The largest sealed blob accepted, in bytes.
NUXT_EDITOR_MAX_BLOB_BYTES=1048576

# Uploads (new sessions and change sets) per client address per window (seconds).
NUXT_EDITOR_RATE_LIMIT=30
NUXT_EDITOR_RATE_LIMIT_WINDOW=600
# Result requests and live-apply socket connections per client address per window (seconds).
NUXT_EDITOR_LIVE_RATE_LIMIT=120
NUXT_EDITOR_LIVE_RATE_LIMIT_WINDOW=60

# Read the client address from X-Forwarded-For (its last entry). Only behind a reverse proxy
# that sets the header; otherwise clients could pick their own address.
NUXT_EDITOR_TRUST_PROXY=false

# When set, POST /api/sessions needs "Authorization: Bearer <token>" (the plugin's web.token).
NUXT_EDITOR_UPLOAD_TOKEN=

# Seconds between sweeps that delete expired blobs (0 turns the timer off; reads still refuse
# expired blobs).
NUXT_EDITOR_PURGE_INTERVAL=600

# Live apply: seconds of silence after which a socket is closed, and browser sockets per session.
NUXT_EDITOR_SOCKET_SILENCE=60
NUXT_EDITOR_SOCKET_MAX_BROWSERS=5

# A public editor instance to name in the docs (shown as "run by the author, no uptime
# guarantee"). Empty: the docs name none.
NUXT_PUBLIC_PUBLIC_INSTANCE_URL=
